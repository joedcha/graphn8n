# Copiar a .env y completar. NUNCA commitear el .env real.

# n8n
N8N_BASE_URL=https://n8n-telefonica.nh.inet
N8N_API_KEY=
# Poner en "false" SOLO si el certificado de la instancia esta vencido y
# todavia no se pudo renovar (deshabilita la verificacion TLS).
N8N_VERIFY_TLS=true

# Zabbix (server o proxy que recibe el trafico trapper, puerto 10051 default)
ZABBIX_SERVER_HOST=10.203.37.144
ZABBIX_SERVER_PORT=10051
# Ruta al binario zabbix_sender en el servidor donde corre el bridge.
ZABBIX_SENDER_BIN=/usr/bin/zabbix_sender
# Nombre del host configurado en Zabbix (Data collection > Hosts) que tiene
# la plantilla n8n aplicada. NO es la URL, es el "Host name" de Zabbix.
ZABBIX_HOST_NAME=n8nwkf

# Tag que marca un workflow como critico (para items por-nodo historicos)
CRITICAL_TAG=criticidad:alta

# Si es "true", discovery/executions/governance solo consideran workflows
# tageados con CRITICAL_TAG -- modo piloto para no cargar los 341 workflows
# de una. Sacar (o poner en "false") para monitorear todos.
ONLY_CRITICAL=true

# SLO de duracion (ms) por defecto para workflows sin tag `slo:<segundos>`
# propio. Cada workflow puede overridear esto con un tag en n8n, ej. "slo:600".
DEFAULT_SLO_MS=60000

# Si es "true", no envia nada a Zabbix: solo loguea los payloads por stdout.
# Usar esto primero para validar la lectura de n8n antes de tocar Zabbix.
DRY_RUN=true

# Archivo donde se guarda el checkpoint de la ultima ejecucion procesada.
STATE_FILE=/opt/bmc/ETLs/n8n/monworkflows/state.json
